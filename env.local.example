# Copy these lines into a file named .env.local in the project root (my-studio/)
# Never commit .env.local to Git.

# Where the enquiry emails should arrive
ESTIMATE_TO_EMAIL=vrinteriorsvitz@gmail.com

# SMTP login used to send the email.
# Gmail example (needs 2-Step Verification + an App Password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=vrinteriorsvitz@gmail.com
SMTP_PASS=abcdefghijklmnop

# Optional: the "from" name shown in the inbox
SMTP_FROM="VR Interiors Website <vrinteriorsvitz@gmail.com>"
